# vimode keymap, for the extension in ~/Code/vimode. Import it with
# :importConfig after every change. This is the whole keymap, with nothing
# built in underneath: a key does something only if a line here maps it.
# `map <keys> <command>` and `set <name> <value>`, in Vimium's syntax. Problems
# (an unknown command, a typo) are listed after the import and skip just that
# line.

# A page that focuses a field as it loads would otherwise start in insert mode
# and swallow the first keys meant for here.
set grabBackFocus true

# A printable key with no mapping is dropped in normal mode instead of reaching
# the page, as in qutebrowser. Otherwise Google Docs takes any such key as
# typing, refocuses its editor and drops into insert mode. Keys with Ctrl or
# Alt, and arrows, space and Enter, still pass.
set passUnmappedKeys false

# The characters link hints are made of (Vimium's default). The labels keep
# Vimode's default look (Vimium's yellow).
set linkHintCharacters sadfjklewcmpgh

# Pausing halfway through a key sequence shows the keys that continue it,
# after this many ms (qutebrowser's keyhint.delay).
set keyhintDelay 500

# Modes
map i enterInsertMode
map : enterCommandMode
map ? showHelp
map gi focusInput

# Link hints, Vimium's keys. Holding Shift while picking swaps opening in this
# tab and in a new one; Space cycles labels that overlap.
map f LinkHints.activateMode
map F LinkHints.activateModeToOpenInNewTab
map <a-f> LinkHints.activateModeWithQueue
map yf LinkHints.activateModeToCopyLinkUrl

# Find. Lowercase ignores case, a capital makes it exact; Escape clears the
# highlights.
map / enterFindMode
map n performFind
map N performBackwardsFind

# Scrolling
map j scrollDown
map k scrollUp
map h scrollLeft
map <c-d> scrollPageDown
map <c-u> scrollPageUp
map gg scrollToTop
map G scrollToBottom
map zH scrollToLeft
map zL scrollToRight

# History and the address. o opens a URL or searches (bookmarks and history
# listed as you type), O does it in a new tab, as in qutebrowser.
map o open
# l as in the browser's Ctrl+L, which focuses the address bar.
map l open
map O openInNewTab
# The browser keeps Ctrl+T to itself, so t stands in for it.
map t openInNewTab
map <c-o> goBack
map <c-i> goForward
map gu goUp
map gU goToRoot
map yy copyCurrentUrl

# Tabs
map L nextTab
map H previousTab
map g0 firstTab
map g$ lastTab
map ^ visitPreviousTab
map bt createTab
map yt duplicateTab
map bd removeTab
map X restoreTab
map <a-p> togglePinTab
map bo closeOtherTabs
map br closeTabsOnRight
map bH moveTabLeft
map bL moveTabRight
