{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  // fastfetch finds the terminal by walking up the process tree, skipping
  // shells and the only two multiplexers it knows -- tmux and zellij. herdr is
  // neither, so the walk stops on it and the Terminal line reads "herdr"
  // instead of the terminal actually drawing the pixels. There is no config
  // hook to teach it a third multiplexer, so the line is taken from
  // $TERM_PROGRAM, which ghostty sets and herdr passes through untouched.
  // $TERM is the fallback for a bare tty, where $TERM_PROGRAM is unset.
  //
  // Replacing one module means listing them all: in this config the array *is*
  // the structure. This is `fastfetch --print-structure` for 2.67.1 with
  // "terminal" swapped out and "Age" added, so a later fastfetch that adds a
  // module to its defaults will not show it here until it is added below.
  //
  // "terminalfont" stays in the list but prints nothing, and did so before
  // this file existed: it resolves a font from the detected terminal, and it
  // cannot find one for herdr either.
  "modules": [
    "title",
    "separator",
    "os",
    "host",
    "kernel",
    "uptime",
    // There is no built-in module for how long ago this system was
    // installed, so the age is derived from the birth time of / -- btrfs
    // records one, and it survives everything short of a reinstall. On a
    // filesystem that reports no birth time, the timestamp of the first
    // line of the pacman log stands in; if neither is available the module
    // prints nothing rather than a wrong number.
    {
      "type": "command",
      "key": "Age",
      "text": "b=$(stat -c %W /); [ \"${b:-0}\" -gt 0 ] || b=$(date -d \"$(sed -n '1s/^\\[\\([^]]*\\)\\].*/\\1/p' /var/log/pacman.log)\" +%s 2>/dev/null); [ \"${b:-0}\" -gt 0 ] || exit 0; d=$(( ($(date +%s) - b) / 86400 )); y=$((d / 365)); r=$((d % 365)); [ \"$y\" -gt 0 ] && printf '%d year%s, ' \"$y\" \"$([ \"$y\" = 1 ] || echo s)\"; printf '%d day%s' \"$r\" \"$([ \"$r\" = 1 ] || echo s)\""
    },
    "packages",
    "shell",
    "display",
    "de",
    "wm",
    "wmtheme",
    "theme",
    "icons",
    "font",
    "cursor",
    {
      "type": "command",
      "key": "Terminal",
      "text": "if [ -n \"$TERM_PROGRAM\" ]; then printf '%s %s' \"$TERM_PROGRAM\" \"$TERM_PROGRAM_VERSION\"; else printf '%s' \"${TERM:-unknown}\"; fi"
    },
    "terminalfont",
    "cpu",
    "gpu",
    "memory",
    "swap",
    "disk",
    "localip",
    "battery",
    "poweradapter",
    "locale",
    "break",
    "colors"
  ]
}
