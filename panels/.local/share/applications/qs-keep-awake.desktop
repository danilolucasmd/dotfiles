[Desktop Entry]
Type=Application
Name=Keep awake
Comment=Hold the screen and the machine up — no lock, no blank, no idle suspend
Icon=preferences-desktop-screensaver-symbolic
Keywords=quickshell;keep;awake;caffeine;idle;inhibit;lock;blank;sleep;suspend;screensaver;
Exec=qs ipc call keepAwake toggle
