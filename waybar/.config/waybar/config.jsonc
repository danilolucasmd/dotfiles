{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "custom/arch",
    "custom/ws1",
    "custom/ws2",
    "custom/ws3",
    "custom/ws4",
    "custom/ws5",
    "custom/ws-events",
    "hyprland/window"
  ],

  "modules-center": [
    "custom/weather",
    "clock"
  ],

  "modules-right": [
    "custom/media",
    "custom/recording",
    "custom/keyboard-layout",
    "custom/mic",
    "pulseaudio#icon",
    "pulseaudio#text",
    "custom/bluetooth",
    "network",
    "battery",
    "tray",
    "custom/updates",
    "custom/notifications"
  ],

  "hyprland/window": {
    "separate-outputs": true
  },

  "custom/ws1": {
    "exec": "~/.config/waybar/scripts/workspace-state.sh 1",
    "return-type": "json",
    "format": "{}",
    "signal": 1,
    "on-click": "hyprctl dispatch workspace 1",
    "tooltip": false
  },
  "custom/ws2": {
    "exec": "~/.config/waybar/scripts/workspace-state.sh 2",
    "return-type": "json",
    "format": "{}",
    "signal": 1,
    "on-click": "hyprctl dispatch workspace 2",
    "tooltip": false
  },
  "custom/ws3": {
    "exec": "~/.config/waybar/scripts/workspace-state.sh 3",
    "return-type": "json",
    "format": "{}",
    "signal": 1,
    "on-click": "hyprctl dispatch workspace 3",
    "tooltip": false
  },
  "custom/ws4": {
    "exec": "~/.config/waybar/scripts/workspace-state.sh 4",
    "return-type": "json",
    "format": "{}",
    "signal": 1,
    "on-click": "hyprctl dispatch workspace 4",
    "tooltip": false
  },
  "custom/ws5": {
    "exec": "~/.config/waybar/scripts/workspace-state.sh 5",
    "return-type": "json",
    "format": "{}",
    "signal": 1,
    "on-click": "hyprctl dispatch workspace 5",
    "tooltip": false
  },
  "custom/ws-events": {
    "exec": "~/.config/waybar/scripts/ws-events.py",
    "restart-interval": 3,
    "format": "",
    "tooltip": false
  },

  "custom/weather": {
    "exec": "~/.config/waybar/scripts/weather.sh",
    "interval": 900,
    "signal": 10,
    "on-click": "pkill -RTMIN+10 waybar",
    "exec-on-event": false,
    "return-type": "json",
    "tooltip": true
  },

  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip": false,
  },

  "custom/media": {
    "exec": "~/.config/waybar/scripts/media.sh",
    "return-type": "json",
    "on-click": "playerctl play-pause",
    "on-scroll-up": "playerctl next",
    "on-scroll-down": "playerctl previous",
    "tooltip": true
  },

  "custom/notifications": {
    "exec": "~/.config/waybar/scripts/notifications.sh",
    "interval": 5,
    "signal": 9,
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/notifications-menu.sh",
    "tooltip": true
  },

  "custom/recording": {
    "exec": "~/.config/waybar/scripts/recording.sh",
    "interval": 1,
    "return-type": "json",
    "tooltip": true
  },

  "pulseaudio#icon": {
    "format": "{icon}",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "pulseaudio#text": {
    "format": "{volume}%"
  },

  "custom/keyboard-layout": {
    "exec": "~/.config/waybar/scripts/keyboard-layout.sh",
    "return-type": "json",
    "tooltip": true
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/sounds/scripts/toggle-mic.sh",
    "tooltip": true
  },

  "custom/updates": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "interval": 1800,
    "signal": 8,
    "on-click": "pkill -RTMIN+8 waybar",
    "exec-on-event": false,
    "return-type": "json",
    "tooltip": true
  },

  "custom/bluetooth": {
    "exec": "~/.config/waybar/scripts/bluetooth.sh",
    "return-type": "json",
    "on-click": "~/.config/waybar/scripts/bluetooth.sh toggle",
    "tooltip": true
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip": true
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "tray": {
    "spacing": 16
  }
}
