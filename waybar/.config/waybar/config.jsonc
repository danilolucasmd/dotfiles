{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 0,

  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "hyprland/window"
  ],

  "modules-center": [
    "clock"
  ],

  "modules-right": [
    "custom/mic",
    "pulseaudio#icon",
    "pulseaudio#text",
    "network",
    "battery",
    "tray"
  ],

  "hyprland/window": {
    "separate-outputs": true
  },

  "hyprland/workspaces": {
    "disable-scroll": true,
    "all-outputs": true,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5
    }
  },

  "clock": {
    "format": "{:%a %d %b %H:%M}",
    "tooltip": false,
  },

  "pulseaudio#icon": {
    "format": "{icon}",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"]
    }
  },

  "pulseaudio#text": {
    "format": "{volume}%"
  },

  "custom/mic": {
    "exec": "~/.config/waybar/scripts/mic.sh",
    "interval": 1,
    "return-type": "json",
    "on-click": "~/.config/sounds/scripts/toggle-mic.sh",
    "tooltip": true
  },

  "network": {
    "format-wifi": "󰤨 {signalStrength}%",
    "format-ethernet": "󰈀",
    "format-disconnected": "󰤭",
    "tooltip": true
  },

  "battery": {
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-icons": ["󰁺","󰁻","󰁼","󰁽","󰁾","󰁿","󰂀","󰂁","󰂂","󰁹"]
  },

  "tray": {
    "spacing": 16
  }
}
