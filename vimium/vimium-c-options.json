{
  "name": "Vimium C",
  "exclusionRules": [],
  "grabBackFocus": true,
  "ignoreKeyboardLayout": true,
  "keyMappings": [
    "# Focus / insert-mode escape hatches",
    "map <c-]> <esc>",
    "map \\\\ passNextKey normal",
    "map gI switchFocus",
    "",
    "# History",
    "map <c-o> goBack",
    "map <c-i> goForward",
    "",
    "# Tab manipulation",
    "map L nextTab",
    "map H previousTab",
    "map <a-l> nextTab",
    "map <a-l:i> nextTab",
    "map <a-h> previousTab",
    "map <a-h:i> previousTab",
    "map bo closeOtherTabs",
    "map br closeTabsOnRight",
    "map bH moveTabLeft",
    "map bL moveTabRight",
    "",
    "# Scrolling",
    "map <c-u> scrollPageUp",
    "map <c-d> scrollPageDown",
    "",
    "# Resets",
    "unmap J",
    "unmap K",
    "unmap u",
    "unmap d",
    "unmap b",
    "unmap t",
    "unmap x",
    "unmap r",
    "unmap p",
    "unmap P",
    "",
    "# Disable omnibar",
    "unmap o",
    "unmap O",
    "unmap B",
    "unmap T",
    "unmap ge"
  ]
}
