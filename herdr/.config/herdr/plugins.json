[
  {
    "plugin_id": "herdr-clone-layout",
    "name": "Clone Layout",
    "version": "0.8.0",
    "min_herdr_version": "0.7.0",
    "description": "Every new workspace/worktree inherits the tab + pane-split geometry of the workspace you were just in (geometry only — panes open as bare shells).",
    "manifest_path": "/Users/ddias/Code/herdr-clone-layout/herdr-plugin.toml",
    "plugin_root": "/Users/ddias/Code/herdr-clone-layout",
    "enabled": true,
    "platforms": [
      "linux",
      "macos"
    ],
    "actions": [
      {
        "id": "apply",
        "title": "Duplicate workspace layout",
        "contexts": [
          "workspace"
        ],
        "command": [
          "sh",
          "bin/clone-layout",
          "apply"
        ]
      }
    ],
    "events": [
      {
        "on": "workspace.created",
        "command": [
          "sh",
          "bin/clone-layout",
          "event"
        ]
      },
      {
        "on": "workspace.focused",
        "command": [
          "sh",
          "bin/clone-layout",
          "event"
        ]
      },
      {
        "on": "worktree.created",
        "command": [
          "sh",
          "bin/clone-layout",
          "event"
        ]
      }
    ],
    "panes": [
      {
        "id": "choose-layout",
        "title": "clone layout",
        "placement": "popup",
        "width": 66,
        "height": 16,
        "command": [
          "sh",
          "bin/clone-layout-dialog"
        ]
      }
    ],
    "source": {
      "kind": "local"
    }
  }
]