# delta — syntax-highlighting pager for git/diff output.
# This file is git-config format and is pulled in via [include] from
# ~/.config/git/config, so [delta] settings apply to git's use of delta.

[delta]
	navigate = true          # use n / N to jump between diff sections
	line-numbers = true
	hyperlinks = true
	dark = true
	side-by-side = false
	file-style = bold yellow
	file-decoration-style = none
	hunk-header-decoration-style = cyan box ul

[merge]
	conflictStyle = zdiff3

[diff]
	colorMoved = default
