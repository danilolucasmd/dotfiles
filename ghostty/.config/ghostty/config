background = #2C292F
font-size = 11

# Quit Ghostty when the last window closes so it doesn't linger in the dock
quit-after-last-window-closed = true

# Close windows/tabs/splits without a confirmation prompt
confirm-close-surface = false

# Ctrl+Backspace deletes the previous word. Emit ESC+DEL (the same bytes as
# Option+Backspace) so zsh/readline/nvim run backward-kill-word. Owned by
# Ghostty itself instead of a Karabiner remap, which drops out after sleep/wake
# and silently breaks the shortcut inside herdr. Karabiner's "Ctrl+Backspace =>
# Cmd+Backspace" rule now excludes Ghostty so this binding wins.
keybind = ctrl+backspace=text:\x1b\x7f

# Ctrl+Enter and Shift+Enter insert a newline. Without this, an app that turns
# on xterm's modifyOtherKeys mode (Claude Code does) makes Ghostty encode these
# keys as ESC[27;5;13~ and ESC[27;2;13~, and any app that does not decode that
# form prints the tail (";5;13~", "2;13~") straight into the prompt. Sending a
# bare LF, the same byte as Ctrl+J, skips key encoding altogether, so the result
# is identical everywhere: a newline in Claude Code and nvim, submit in zsh.
keybind = ctrl+enter=text:\n
keybind = shift+enter=text:\n
