sort=-time
layer=overlay
background-color=#2e3440
width=300
height=110
border-size=2
border-color=#88c0d0
border-radius=15
icons=0
max-icon-size=64
default-timeout=5000
ignore-timeout=1
font=monospace 11
padding=12
margin=10

# Log every notification to a persistent history store (for the waybar bell).
on-notify=exec "$HOME/.config/mako/scripts/capture.sh" "$id"

# Left click jumps to the app that sent the notification, across workspaces.
# Needs misc:focus_on_activate=true in hyprland.conf; see the script.
on-button-left=exec "$HOME/.config/mako/scripts/focus-sender.sh" "$id"

[urgency=low]
border-color=#cccccc

[urgency=normal]
border-color=#d08770

[urgency=high]
border-color=#bf616a
default-timeout=0

[category=mpd]
default-timeout=2000
group-by=category
